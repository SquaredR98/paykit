# PayKit Website Environment Variables
# Copy this file to .env.local and fill in your values

# Stripe API Keys (test mode)
# Get them from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Razorpay API Keys (test mode)
# Get them from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...

# PayPal API Credentials (sandbox)
# Get them from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...

# Resend (contact form emails)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_...
CONTACT_EMAIL=hello@squaredr.tech

# Google Tag Manager
# Get your container ID from: https://tagmanager.google.com
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
